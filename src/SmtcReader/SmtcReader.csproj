<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>SmtcReader</RootNamespace>
    <AssemblyName>smtc-reader</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Trimming stays off on purpose: the raw report enumerates WinRT properties by
      reflection, so a trimmed build would silently drop fields instead of failing.
      Shipping ~95 MB of self-contained runtime is the cheaper trade.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
